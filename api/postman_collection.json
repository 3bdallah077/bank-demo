      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accountNumber",
      "value": "EGP-001-1234567890"
    },
    {
      "key": "targetAccount",
      "value": "EGP-002-0987654321"
    },
    {
      "key": "today",
      "value": "{{$isoTimestamp}}"
    },
    {
      "key": "signupUser",
      "value": "newuser_739569"
    },
    {
      "key": "signupId",
      "value": ""
    },
