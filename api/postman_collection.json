        {
          "name": "01 Login customer1 (keeps the session cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"customer1\",\"password\":\"Demo@1234\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('FR-01 valid login returns 200', () => pm.response.to.have.status(200));",
                  "const u = pm.response.json();",
                  "pm.test('FR-01 role is CUSTOMER', () => pm.expect(u.role).to.eql('CUSTOMER'));",
                  "pm.test('NFR-02 no password hash in the response', () => pm.expect(JSON.stringify(u)).to.not.include('$2a$'));"
                ]
